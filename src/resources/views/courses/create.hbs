
<div class="container my-5 py-5">
  <div class="card-form">
    <div class="card-header text-center">
      <h4 class="mb-4">Tạo Khóa Học Mới</h4>
    </div>
    <div class="card-body">
      <form method="POST" action="/courses/store" class="needs-validation" novalidate>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="name" class="form-label">Tên khóa học</label>
            <input type="text" class="form-control" name="name" id="name" placeholder="Nhập tên khóa học" required>
            <div class="invalid-feedback">
              Vui lòng nhập tên khóa học.
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label for="level" class="form-label">Trình độ</label>
            <select class="form-select" name="level" id="level" required>
              <option value="">Chọn trình độ</option>
              <option value="Cơ bản">Cơ bản</option>
              <option value="Trung cấp">Trung cấp</option>
              <option value="Nâng cao">Nâng cao</option>
            </select>
            <div class="invalid-feedback">
              Vui lòng chọn trình độ.
            </div>
          </div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Mô tả</label>
          <textarea class="form-control" name="description" id="description" rows="3" placeholder="Mô tả khóa học" required></textarea>
          <div class="invalid-feedback">
            Vui lòng nhập mô tả.
          </div>
        </div>
        <div class="mb-3">
          <label for="videoId" class="form-label">Video ID</label>
          <input type="text" class="form-control" name="videoId" id="videoId" placeholder="ID video YouTube" required>
          <div class="invalid-feedback">
            Vui lòng nhập ID video.
          </div>
        </div>
        <div class="d-flex justify-content-between">
          <a href="/courses" class="btn btn-secondary">Quay lại</a>
          <button type="submit" class="btn btn-primary">Tạo Khóa Học</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Bootstrap form validation
(function () {
  'use strict'
  var forms = document.querySelectorAll('.needs-validation')
  Array.prototype.slice.call(forms)
    .forEach(function (form) {
      form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
})()
</script>