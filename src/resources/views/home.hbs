<div class="container my-5">
  <!-- Hero Section -->
  <div class="text-center mb-5 hero-section"
    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 40px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
    <h1 class="display-4 fw-bold"><i class="fas fa-graduation-cap"></i> Welcome to TTT</h1>
    <p class="lead">Discover and manage your online courses with ease. Start learning today!</p>
    <a href="/me/stored/courses" class="btn btn-light btn-lg rounded-pill shadow"><i class="fas fa-book"></i> My
      Courses</a>
  </div>

  <!-- Courses Section -->
  <h2 class="text-center mb-4 fw-bold courses-section"><i class="fas fa-list"></i> Featured Courses</h2>
  <div class="row">
    {{#each courses}}
    <div class="col-sm-6 col-lg-4 mb-4">
      <div class="card h-100 shadow-sm border-0"
        style="border-radius: 15px; overflow: hidden; transition: transform 0.3s;">
        <a href="/courses/{{this.slug}}" class="text-decoration-none">
          <img src="{{this.image}}" class="card-img-top" alt="{{this.name}}" style="height: 200px; object-fit: cover;">
        </a>
        <div class="card-body d-flex flex-column">
          <a href="/courses/{{this.slug}}" class="text-decoration-none">
            <h5 class="card-title text-dark fw-bold">{{this.name}}</h5>
          </a>
          <p class="card-text text-muted flex-grow-1">{{this.description}}</p>
          <a href="/courses/{{this.slug}}" class="btn btn-primary rounded-pill mt-auto"><i class="fas fa-eye"></i> View
            Course</a>
        </div>
      </div>
    </div>
    {{/each}}
  </div>

  <!-- Call to Action -->
  <div class="text-center mt-5 cta-section">
    <a href="/courses/create" class="btn btn-success btn-lg rounded-pill shadow"><i class="fas fa-plus"></i> Create New
      Course</a>
  </div>
</div>